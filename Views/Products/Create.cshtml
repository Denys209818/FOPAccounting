@model Product
<div class="page-title"><div><h1>Додавання товару</h1><p>Заповніть дані товарної позиції для складського обліку.</p></div></div>
<form method="post" class="form wide">
<input type="hidden" name="Id" value="@Model.Id" />
<div class="form-grid">
<div><label>Артикул</label><input name="Sku" value="@Model.Sku" required /></div>
<div><label>Назва</label><input name="Name" value="@Model.Name" required /></div>
<div><label>Категорія</label><input name="Category" value="@Model.Category" required /></div>
<div><label>Склад</label><input name="Warehouse" value="@Model.Warehouse" required /></div>
<div><label>Одиниця виміру</label><input name="Unit" value="@Model.Unit" /></div>
<div><label>Кількість</label><input name="Quantity" type="number" value="@Model.Quantity" required /></div>
<div><label>Мінімальний залишок</label><input name="MinQuantity" type="number" value="@Model.MinQuantity" required /></div>
<div><label>Закупівельна ціна</label><input name="PurchasePrice" type="number" step="0.01" value="@Model.PurchasePrice" required /></div>
<div><label>Ціна продажу</label><input name="SalePrice" type="number" step="0.01" value="@Model.SalePrice" required /></div>
</div>
<button class="btn">Зберегти</button> <a class="light-btn" href="/Products/Index">Назад</a>
</form>
