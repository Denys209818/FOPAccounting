@using FopAccounting.Models
@{ var users = ViewBag.Users as List<User>; var accesses = ViewBag.Accesses as List<UserProfileAccess>; }
<div class="page-title"><div><h1>Керування доступами</h1><p>Власник профілю може додавати користувачів і призначати ролі.</p></div></div>
<section class="panel">
<form method="post" action="/Profiles/AddAccess" class="inline-form">
    <select name="userId">@foreach(var u in users ?? new List<User>()) { <option value="@u.Id">@u.FullName (@u.Email)</option> }</select>
    <select name="role"><option value="Owner">Owner</option><option value="Accountant">Accountant</option><option value="Manager">Manager</option><option value="Viewer">Viewer</option></select>
    <button class="btn">Додати доступ</button>
</form>
<table><thead><tr><th>Користувач</th><th>Email</th><th>Роль</th><th></th></tr></thead><tbody>
@foreach(var a in accesses ?? new List<UserProfileAccess>()) { var u = users?.FirstOrDefault(x => x.Id == a.UserId); <tr><td>@u?.FullName</td><td>@u?.Email</td><td><span class="badge">@a.Role?.RoleName</span></td><td><a class="danger" href="/Profiles/RemoveAccess/@a.Id">Прибрати</a></td></tr> }
</tbody></table>
</section>
